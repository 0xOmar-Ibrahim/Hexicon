{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0xOmar-Ibrahim/Hexicon/schema/path.schema.json",
  "title": "Hexicon learning path",
  "description": "File path: data/paths/<id>.yml. Each step references an existing resource as <domain>/<file-name-without-.yml>.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "description", "level", "steps", "added_by"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "icon": { "type": "string" },
    "title": { "$ref": "#/$defs/i18n" },
    "description": { "$ref": "#/$defs/i18n" },
    "level": { "enum": ["beginner", "intermediate", "advanced"] },
    "hours": { "type": "integer", "minimum": 1, "description": "Rough total effort estimate." },
    "steps": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["resource"],
        "properties": {
          "resource": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" },
          "note": { "type": "string", "maxLength": 240 }
        }
      }
    },
    "added_by": { "type": "string", "pattern": "^@[A-Za-z0-9-]+$" }
  },
  "$defs": {
    "i18n": {
      "type": "object", "required": ["en"], "additionalProperties": false,
      "properties": { "en": { "type": "string" }, "de": { "type": "string" }, "fr": { "type": "string" }, "ar": { "type": "string" }, "ru": { "type": "string" } }
    }
  }
}
