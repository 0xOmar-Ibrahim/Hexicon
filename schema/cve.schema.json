{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0xOmar-Ibrahim/Hexicon/schema/cve.schema.json",
  "title": "Hexicon CVE page",
  "description": "File path: data/cves/<year>/CVE-YYYY-NNNN.yml. Fields under `official` are synced from NVD / CISA KEV / FIRST EPSS by scripts/sync-cves and must NOT be hand-edited. Contributors curate everything else.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "summary", "references", "added_by", "added_on"],
  "properties": {
    "id": { "type": "string", "pattern": "^CVE-\\d{4}-\\d{4,}$" },
    "nickname": { "type": "string", "description": "Common name, e.g. Log4Shell, EternalBlue." },
    "official": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "published": { "type": "string", "format": "date" },
        "cvss": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": { "enum": ["2.0", "3.0", "3.1", "4.0"] },
            "score": { "type": "number", "minimum": 0, "maximum": 10 },
            "vector": { "type": "string" },
            "severity": { "enum": ["none", "low", "medium", "high", "critical"] }
          }
        },
        "cwe": { "type": "array", "items": { "type": "string", "pattern": "^(CWE-\\d+|NVD-CWE-Other|NVD-CWE-noinfo)$" } },
        "kev": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "listed": { "type": "boolean" },
            "date_added": { "type": "string", "format": "date" },
            "ransomware_use": { "enum": ["Known", "Unknown"] }
          }
        },
        "epss": { "type": "object", "properties": { "score": { "type": "number" }, "percentile": { "type": "number" }, "date": { "type": "string", "format": "date" } } },
        "synced_on": { "type": "string", "format": "date" }
      }
    },
    "affected": {
      "type": "array",
      "items": { "type": "object", "required": ["vendor", "product"], "properties": { "vendor": { "type": "string" }, "product": { "type": "string" }, "versions": { "type": "string" } } }
    },
    "summary": {
      "type": "object", "required": ["en"], "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 40, "maxLength": 1200 },
        "de": { "type": "string" }, "fr": { "type": "string" }, "ar": { "type": "string" }, "ru": { "type": "string" }
      }
    },
    "references": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["kind", "url"],
        "properties": {
          "kind": { "enum": ["advisory", "writeup", "analysis", "poc", "detection", "lab", "patch", "mitigation", "video", "news"] },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "title": { "type": "string" },
          "language": { "type": "string", "pattern": "^[a-z]{2}$", "default": "en" }
        }
      }
    },
    "mitre_attack": { "type": "array", "items": { "type": "string", "pattern": "^(T\\d{4}(\\.\\d{3})?|TA\\d{4})$" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "added_by": { "type": "string", "pattern": "^@[A-Za-z0-9-]+$" },
    "added_on": { "type": "string", "format": "date" }
  }
}
